data/master/backup/
data/users/*/backup/
__pycache__/
*.pyc
api_autostart.log
.venv/

# SQLite가 실행 중에 만드는 임시 파일 (DB 본체가 아니므로 추적하지 않는다)
*.db-shm
*.db-wal

# 비밀번호 해시·실제 고객 데이터가 들어있는 DB — git에 올리면 안 된다
auth.db
data/access_log.db
data/master/master.db
data/master/master.tmp.db
data/users/

# 데이터를 크게 손대기 전에 그때그때 뜨는 수동 백업(master_before_*.db).
# 하나에 60MB가 넘어서 실수로 커밋되면 저장소가 통째로 무거워진다.
data/master/master_before_*.db
data/master/*_backup_*.db

# 큰 작업(배변 백필 등) 전에 그때그때 뜨는 수동 백업 폴더.
# 안에 master.db/user.db 사본이 들어 있어 수십 MB다 — 저장소에 올리면 안 된다.
data/_*백업_*/
